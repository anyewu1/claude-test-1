/* app.wxss - 全局样式 */

page {
  background-color: #F5F7FA;
  color: #333;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* 主题色变量 */
.primary { color: #4A90E2; }
.primary-bg { background-color: #4A90E2; }
.success { color: #52C41A; }
.warning { color: #FAAD14; }
.danger { color: #FF4D4F; }
.text-muted { color: #999; }
.text-sub { color: #666; }

/* 通用容器 */
.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 按钮 */
.btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  line-height: 1.4;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90E2, #7B68EE);
  color: #fff;
}

.btn-default {
  background: #f5f5f5;
  color: #333;
}

button::after {
  border: none;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content {
  flex: 1;
  min-width: 0;
}

.list-item-arrow {
  color: #ccc;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #E8F0FE;
  color: #4A90E2;
  margin-right: 12rpx;
}

.tag-success { background: #F0FAE8; color: #52C41A; }
.tag-warning { background: #FFF7E6; color: #FAAD14; }
.tag-danger { background: #FFF1F0; color: #FF4D4F; }

/* 安全区适配 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 文字省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 弹性布局工具 */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }
