.page { padding: 24rpx; padding-bottom: 60rpx; }

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #4A90E2, #7B68EE);
  border-radius: 20rpx 20rpx 0 0;
  padding: 32rpx;
  color: #fff;
}

.arrow {
  font-size: 48rpx;
  width: 60rpx;
  text-align: center;
}

.month-text {
  font-size: 36rpx;
  font-weight: 600;
}

.week-header {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.date-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 0 0 20rpx 20rpx;
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.date-cell {
  width: 14.285%;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 28rpx;
  color: #333;
}

.date-cell.other-month { color: #ccc; }

.date-cell.today .date-num {
  background: #4A90E2;
  color: #fff;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-cell.selected .date-num {
  background: #FAAD14;
  color: #fff;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-cell.today.selected .date-num {
  background: #FF4D4F;
}

.event-dot {
  width: 8rpx;
  height: 8rpx;
  background: #FF4D4F;
  border-radius: 50%;
  margin-top: 4rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}

.event-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.event-item:last-child { border-bottom: none; }

.event-date {
  width: 180rpx;
  font-size: 24rpx;
  color: #4A90E2;
  font-weight: 600;
}

.event-tag {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  margin-right: 16rpx;
}

.type-exam { background: #FFF1F0; color: #FF4D4F; }
.type-class { background: #E8F0FE; color: #4A90E2; }
.type-activity { background: #FFF7E6; color: #FAAD14; }
.type-important { background: #F9F0FF; color: #722ED1; }

.event-title {
  font-size: 26rpx;
  color: #333;
}

.flex-1 { flex: 1; }

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
