.page { padding: 24rpx; padding-bottom: 60rpx; }

.header {
  background: linear-gradient(135deg, #4A90E2, #7B68EE);
  border-radius: 20rpx;
  padding: 50rpx 32rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 24rpx;
}

.streak {
  font-size: 100rpx;
  font-weight: 700;
  line-height: 1;
}

.streak-label {
  font-size: 26rpx;
  margin-top: 12rpx;
  opacity: 0.9;
}

.checkin-btn {
  margin-top: 32rpx;
  background: #fff;
  color: #4A90E2;
  border: none;
  border-radius: 50rpx;
  padding: 0 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.checkin-btn.checked {
  background: rgba(255,255,255,0.3);
  color: #fff;
}

.checkin-btn[disabled] {
  background: rgba(255,255,255,0.3) !important;
  color: #fff !important;
}

.checkin-tip {
  font-size: 22rpx;
  margin-top: 20rpx;
  opacity: 0.8;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}

.week-header {
  display: flex;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.date-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.date-cell {
  width: 14.285%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 26rpx;
  color: #333;
}

.date-cell.checked {
  color: #fff;
}

.date-cell.checked .date-num {
  background: #52C41A;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.date-cell.today.checked .date-num {
  background: #4A90E2;
}

.date-cell.today:not(.checked) .date-num {
  background: #FFF1F0;
  color: #FF4D4F;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  border: 2rpx solid #FF4D4F;
}

.date-cell.future { color: #ccc; }

.check-mark {
  position: absolute;
  bottom: 8rpx;
  font-size: 18rpx;
  color: #52C41A;
  display: none;
}

.reward-list {
  display: flex;
  justify-content: space-between;
}

.reward-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  background: #FAFBFC;
  margin: 0 8rpx;
  opacity: 0.5;
}

.reward-item.unlocked {
  background: linear-gradient(135deg, #FFF7E6, #FFE7BA);
  opacity: 1;
}

.reward-day {
  font-size: 28rpx;
  font-weight: 600;
  color: #FAAD14;
}

.reward-text {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
}

.stats {
  display: flex;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A90E2;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
