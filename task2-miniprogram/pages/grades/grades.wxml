<view class="page">
  <!-- GPA 统计卡片 -->
  <view class="stats-card">
    <view class="stat-block">
      <view class="stat-num">{{ gpa }}</view>
      <view class="stat-label">学期 GPA</view>
    </view>
    <view class="divider"></view>
    <view class="stat-block">
      <view class="stat-num">{{ avgScore }}</view>
      <view class="stat-label">平均分</view>
    </view>
    <view class="divider"></view>
    <view class="stat-block">
      <view class="stat-num">{{ totalCredit }}</view>
      <view class="stat-label">总学分</view>
    </view>
  </view>

  <!-- 学期筛选 -->
  <view class="filter">
    <view
      class="filter-item {{ activeIdx === idx ? 'active' : '' }}"
      wx:for="{{ semesters }}"
      wx:key="*this"
      wx:for-index="idx"
      bindtap="selectSemester"
      data-idx="{{ idx }}"
    >
      {{ item }}
    </view>
  </view>

  <!-- 成绩列表 -->
  <view class="grade-list">
    <view class="grade-item" wx:for="{{ filteredGrades }}" wx:key="id">
      <view class="grade-info">
        <view class="grade-name">{{ item.name }}</view>
        <view class="grade-meta">
          <text class="tag">{{ item.type }}</text>
          <text class="credit">{{ item.credit }} 学分</text>
        </view>
      </view>
      <view class="grade-score">
        <view class="score-num {{ item.score >= 90 ? 'excellent' : item.score >= 80 ? 'good' : item.score >= 60 ? 'pass' : 'fail' }}">
          {{ item.score }}
        </view>
        <view class="score-label">分</view>
      </view>
    </view>
  </view>

  <view wx:if="{{ filteredGrades.length === 0 }}" class="empty">
    <view class="empty-icon">📊</view>
    <view class="empty-text">本学期暂无成绩</view>
  </view>
</view>
