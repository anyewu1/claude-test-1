.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.stats-card {
  display: flex;
  background: linear-gradient(135deg, #4A90E2, #7B68EE);
  border-radius: 20rpx;
  padding: 40rpx 0;
  color: #fff;
  margin-bottom: 24rpx;
}

.stat-block {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}

.divider {
  width: 1rpx;
  background: rgba(255,255,255,0.3);
}

.filter {
  display: flex;
  background: #fff;
  border-radius: 50rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #666;
  border-radius: 50rpx;
  transition: all 0.2s;
}

.filter-item.active {
  background: #4A90E2;
  color: #fff;
  font-weight: 500;
}

.grade-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.grade-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.grade-item:last-child { border-bottom: none; }

.grade-info {
  flex: 1;
}

.grade-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.grade-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.tag {
  display: inline-block;
  background: #E8F0FE;
  color: #4A90E2;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  margin-right: 12rpx;
}

.credit { color: #999; }

.grade-score {
  text-align: center;
}

.score-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.score-num.excellent { color: #52C41A; }
.score-num.good { color: #4A90E2; }
.score-num.pass { color: #FAAD14; }
.score-num.fail { color: #FF4D4F; }

.score-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
