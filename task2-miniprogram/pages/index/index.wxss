.page {
  padding: 24rpx;
  padding-bottom: 100rpx;
}

.welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #4A90E2, #7B68EE);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.welcome-text .hello {
  font-size: 38rpx;
  font-weight: 600;
}

.welcome-text .sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.stats {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A90E2;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 25%;
  text-align: center;
  padding: 20rpx 0;
}

.grid-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.grid-text {
  font-size: 24rpx;
  color: #666;
}

.course-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #FAFBFC;
  border-radius: 12rpx;
  border-left: 6rpx solid #4A90E2;
  margin-bottom: 16rpx;
}

.course-item:last-child { margin-bottom: 0; }

.course-time {
  width: 100rpx;
  font-size: 24rpx;
  color: #4A90E2;
  font-weight: 600;
}

.course-info {
  flex: 1;
}

.course-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.course-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.todo-item:last-child { border-bottom: none; }

.todo-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.todo-text {
  font-size: 28rpx;
  color: #333;
}

.todo-date {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.link {
  font-size: 24rpx;
  color: #4A90E2;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
