.page { padding: 24rpx; padding-bottom: 60rpx; }

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 50rpx;
  padding: 4rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.search-icon { font-size: 32rpx; margin-right: 16rpx; }

.search-input {
  flex: 1;
  height: 70rpx;
  font-size: 28rpx;
}

.tabs {
  display: flex;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  margin: 0 6rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.tab.active {
  border-color: #4A90E2;
  color: #4A90E2;
  font-weight: 500;
}

.book-list { }

.book-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.book-cover {
  width: 100rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #4A90E2, #7B68EE);
  border-radius: 8rpx;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.book-info { flex: 1; min-width: 0; }

.book-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.book-author {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.book-pub {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.book-status {
  display: flex;
  align-items: center;
}

.status-tag {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  margin-right: 12rpx;
}

.status-tag.borrowed {
  background: #FFF7E6;
  color: #FAAD14;
}

.status-tag.returned {
  background: #F0FAE8;
  color: #52C41A;
}

.return-date {
  font-size: 22rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
