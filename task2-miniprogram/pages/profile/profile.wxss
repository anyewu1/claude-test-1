.page { padding-bottom: 60rpx; }

.profile-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4A90E2, #7B68EE);
  padding: 60rpx 32rpx 100rpx;
  color: #fff;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #fff;
  border: 6rpx solid rgba(255,255,255,0.3);
  margin-right: 32rpx;
}

.info { flex: 1; }

.name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.id, .class {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 6rpx;
}

.stats-row {
  display: flex;
  background: #fff;
  margin: -50rpx 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
}

.stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f0f0f0;
}

.stat:last-child { border-right: none; }

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A90E2;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.menu {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
  width: 48rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 40rpx 0;
}
