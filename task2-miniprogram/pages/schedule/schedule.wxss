.page {
  padding: 24rpx;
  padding-bottom: 100rpx;
}

.header {
  background: linear-gradient(135deg, #4A90E2, #7B68EE);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  text-align: center;
}

.header .title {
  font-size: 32rpx;
  font-weight: 600;
}

.header .sub {
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}

.schedule-table {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.schedule-header {
  display: flex;
  background: #F5F7FA;
  border-bottom: 1rpx solid #eee;
}

.schedule-header .time-col,
.schedule-header .day-col {
  text-align: center;
  font-size: 24rpx;
  color: #666;
  font-weight: 600;
  padding: 20rpx 0;
}

.schedule-row {
  display: flex;
  border-bottom: 1rpx solid #f5f5f5;
}

.schedule-row:last-child { border-bottom: none; }

.time-col {
  width: 110rpx;
  flex-shrink: 0;
  background: #FAFBFC;
  text-align: center;
  padding: 16rpx 4rpx;
  border-right: 1rpx solid #f5f5f5;
}

.period-num {
  font-size: 22rpx;
  color: #4A90E2;
  font-weight: 600;
}

.period-time {
  font-size: 18rpx;
  color: #999;
  margin-top: 4rpx;
}

.day-col {
  flex: 1;
  min-height: 140rpx;
  padding: 6rpx;
  border-right: 1rpx solid #f5f5f5;
}

.day-col:last-child { border-right: none; }

.course-cell {
  background: #4A90E2;
  color: #fff;
  border-radius: 8rpx;
  padding: 10rpx 8rpx;
  height: 100%;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.course-name-cell {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.course-loc {
  font-size: 18rpx;
  margin-top: 4rpx;
  opacity: 0.9;
}

.tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin-top: 32rpx;
}
