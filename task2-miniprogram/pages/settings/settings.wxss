.page { padding: 24rpx; padding-bottom: 60rpx; }

.section-title {
  font-size: 26rpx;
  color: #999;
  padding: 16rpx 8rpx;
  font-weight: 500;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  min-height: 100rpx;
}

.setting-item:last-child { border-bottom: none; }

.setting-item.action { cursor: pointer; }

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.setting-value {
  font-size: 26rpx;
  color: #999;
}

.radio-group {
  display: flex;
}

.radio {
  padding: 8rpx 24rpx;
  margin-left: 12rpx;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.radio.active {
  border-color: #4A90E2;
  color: #4A90E2;
  background: #E8F0FE;
}

.logout-btn {
  background: #fff;
  text-align: center;
  padding: 32rpx 0;
  margin: 32rpx 0;
  border-radius: 16rpx;
  color: #FF4D4F;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
